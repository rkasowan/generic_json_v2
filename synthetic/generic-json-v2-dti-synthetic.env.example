SN_INSTANCE_URL=https://your-instance.service-now.com
SN_USERNAME_B64=base64-encoded-shared-username
SN_PASSWORD_B64=base64-encoded-environment-password
DTI_ENVIRONMENT_NAME=production-1
DTI_CONNECTOR_SOURCE=genericJsonV2
DTI_EVENT_SOURCE=Generic JSON V2 DTI Synthetic
DTI_ASSIGNMENT_GROUP=Event Management
DTI_MESSAGE_KEY_PREFIX=synthetic-generic-json-v2-dti
DTI_OK_MESSAGE_KEY_PREFIX=synthetic-generic-json-v2-ok
DTI_FAILURE_MESSAGE_KEY_PREFIX=synthetic-generic-json-v2-failure
DTI_FAILURE_SEVERITY=2
DTI_POLL_SECONDS=45
DTI_HTTP_TIMEOUT_SECONDS=60
DTI_FAILURE_EMAIL_TO=event-operations@example.com
DTI_FAILURE_EMAIL_FROM=generic-json-v2-synthetic@example.com
DTI_SMTP_HOST=smtp.example.com
DTI_SMTP_PORT=25
DTI_SMTP_STARTTLS=false
