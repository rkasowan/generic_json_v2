# Copy this file to itsmnowUATworker.env and fill in values for this instance only.
# The copied .env file is ignored by Git. Never commit OAuth secrets.
USBEM_INSTANCE_NAME=itsmnowUATworker
USBEM_OAUTH_CLIENT_ID=
USBEM_OAUTH_CLIENT_SECRET=
# Optional OAuth scope, if the OAuth application requires one.
USBEM_OAUTH_SCOPE=

# Caller fixture for this instance. Provide the sys_id for the sys_id input case and as the
# expected stored reference for the full-name case. A full name includes this instance's
# anonymized first name. The verifier checks only Incident API readback.
USBEM_FIXTURE_CALLER_SYS_ID=
USBEM_FIXTURE_CALLER_FULL_NAME=
# Optional assignee mapping checks. Provide the sys_id as the expected reference for the
# full-name case. Leave both blank to allow on-call assignment behavior.
USBEM_FIXTURE_ASSIGNED_TO_SYS_ID=
USBEM_FIXTURE_ASSIGNED_TO_FULL_NAME=
# Must match x_usbna_usb_event.default_caller_sys_id configured in this instance.
USBEM_FIXTURE_DEFAULT_CALLER_SYS_ID=
# Optional exact sys_user.name with multiple matches, for the ambiguity fallback case.
USBEM_FIXTURE_AMBIGUOUS_CALLER_FULL_NAME=

# Optional lookup fixtures. Fill only approved non-sensitive stable values.
USBEM_FIXTURE_CI_NAME=
USBEM_FIXTURE_CI_SYS_ID=
USBEM_FIXTURE_CI_TYPE=
USBEM_FIXTURE_CI_IDENTIFIER=
USBEM_FIXTURE_ASSIGNMENT_GROUP=
USBEM_FIXTURE_CI_SUPPORT_GROUP=
USBEM_FIXTURE_SERVICE_NAME=
USBEM_FIXTURE_OFFERING_NAME=
USBEM_FIXTURE_BUSINESS_APP_CAR_ID=
