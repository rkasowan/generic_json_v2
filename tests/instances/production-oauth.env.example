# Copy this file to production-oauth.env and fill in your OAuth app credentials.
# The copied .env file is ignored by Git. Never commit OAuth secrets.
# The verifier uses only the credentials matching the selected production instance.
# Fill only the instances you intend to test; the selected instance must have a client ID and secret.

USBEM_ITSMNOWDEVWORKER_OAUTH_CLIENT_ID=
USBEM_ITSMNOWDEVWORKER_OAUTH_CLIENT_SECRET=
# Optional; set only if this OAuth application requires a scope.
USBEM_ITSMNOWDEVWORKER_OAUTH_SCOPE=

USBEM_ITSMNOWITWORKER_OAUTH_CLIENT_ID=
USBEM_ITSMNOWITWORKER_OAUTH_CLIENT_SECRET=
USBEM_ITSMNOWITWORKER_OAUTH_SCOPE=

USBEM_ITSMNOWUATWORKER_OAUTH_CLIENT_ID=
USBEM_ITSMNOWUATWORKER_OAUTH_CLIENT_SECRET=
USBEM_ITSMNOWUATWORKER_OAUTH_SCOPE=

USBEM_ITSMNOWWORKER_OAUTH_CLIENT_ID=
USBEM_ITSMNOWWORKER_OAUTH_CLIENT_SECRET=
USBEM_ITSMNOWWORKER_OAUTH_SCOPE=
