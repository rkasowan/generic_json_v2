# Copy to ci_identifier_test.env (ignored by Git). Keep filled files private.
# Run: python3 tests/test_ci_identifier_precedence.py --report-file ci-test-report.json
# Complete default matrix takes at least six minutes: twelve phases observed for 30 seconds.
# Control failures stop earlier. Retains twelve events and expects ten incidents; no deletion/updates.
# Covers five flat CI/duplicate cases and all five wrappers: event/payload/data/record/alert.
# Optional --include-concurrency adds three simultaneous first events and an eleventh expected incident.
SN_INSTANCE_URL=https://your-instance.service-now.com

# Choose Basic OR OAuth client credentials. Base64 is reversible encoding, not encryption.
# Plain SN_USERNAME / SN_PASSWORD are also supported. Prefer b64 for whitespace-containing passwords.
SN_USERNAME_B64=
SN_PASSWORD_B64=
USBEM_OAUTH_CLIENT_ID=
USBEM_OAUTH_CLIENT_SECRET=
USBEM_OAUTH_SCOPE=
# USBEM_OAUTH_CLIENT_ID_B64 and USBEM_OAUTH_CLIENT_SECRET_B64 are also supported.
# Existing verifier production profiles work with --env-file usbem_verify.env --profile itsmnowDEVworker
# using USBEM_ITSMNOWDEVWORKER_URL / OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET / OAUTH_SCOPE.
# Add the focused fixture keys below to that file. Per-profile USBEM_<PROFILE>_<KEY> overrides work.

USBEM_SOURCE=genericJsonV2
USBEM_EXPECTED_RELEASE=2026.10.29.2

# Instance-specific fixtures: two real, DIFFERENT CIs. No CMDB access is needed by this script.
# Name-only and identifier-only control incidents prove the fixtures before conflict cases run.
# Identifier must uniquely select EXPECTED_CI_SYS_ID; decoy name must select DECOY_CI_SYS_ID.
USBEM_CI_TYPE=cmdb_ci_server
USBEM_CI_IDENTIFIER_JSON={"serial_number":"replace-with-unique-serial"}
USBEM_EXPECTED_CI_SYS_ID=replace-with-identifier-selected-ci-sys-id
USBEM_DECOY_CI_NAME=replace-with-different-existing-ci-name
USBEM_DECOY_CI_SYS_ID=replace-with-decoy-ci-sys-id
USBEM_ASSIGNMENT_GROUP=
# If assignment group is a sys_id it is verified automatically. When using a name, supply its sys_id.
USBEM_EXPECTED_ASSIGNMENT_GROUP_SYS_ID=

# Required incident field checks. Use a valid test caller from THIS instance.
# Category/subcategory input can be a choice label or stored value; expected values are stored API values.
# Configure choices that exist in each instance before running the test.
USBEM_TEST_CALLER_SYS_ID=replace-with-existing-test-caller-sys-id
USBEM_TEST_CATEGORY=software
USBEM_EXPECTED_CATEGORY=software
USBEM_TEST_SUBCATEGORY=os
USBEM_EXPECTED_SUBCATEGORY=os
USBEM_TEST_IMPACT=2
USBEM_TEST_URGENCY=2

# Initial and deliberate duplicate submissions each get a separate monotonic deadline.
# The deadline includes POST and readback; POST is attempted ONCE, never blindly retried.
# Increase timeout and stable seconds for instances with slower Event Management/reconciliation.
USBEM_TEST_TIMEOUT_SECONDS=120
# Fast DTI must return a valid incident sys_id within this round-trip budget (including auth).
# This caps each POST request; observation continues separately without holding the POST open.
USBEM_FAST_POST_MAX_SECONDS=10
USBEM_TEST_STABLE_SECONDS=30
USBEM_TEST_POLL_SECONDS=3
USBEM_TEST_REQUEST_TIMEOUT_SECONDS=90
# Optional stress test of the accepted simultaneous-first-event duplicate limitation.
# Leave false for normal acceptance. When true, divergent incidents still make the suite fail.
USBEM_TEST_INCLUDE_CONCURRENCY=false

# TLS verification is on. Supply the work laptop's PEM corporate trust bundle if required.
# CLI --ca-bundle overrides this value. --insecure is an explicit last resort.
USBEM_CA_BUNDLE=

# Requires connector POST, em_event read (sys_id/message_key), and Incident read
# (sys_id/number/cmdb_ci/correlation_id/caller_id/category/subcategory/impact/urgency/
# short_description/description, plus assignment_group when configured).
# A 401/403 or omitted required field fails the suite.
# It validates fast DTI CI precedence, exact incident fields in flat/all five wrapped records,
# assignment group when configured, and sequential duplicate reuse.
# Simultaneous first events for the same key can create duplicates; this accepted residual risk
# is always recorded in the JSON report. Default acceptance never claims concurrent safety.
# Opt-in concurrency fails if more than one incident exists or returned incident IDs diverge.
# All payloads omit wait-for-incident keys; wait mode is legacy compatibility and is not tested.
# It does not read em_alert or prove BR linkage, all concurrent interleavings, or resolved lifecycle.
