# Copy to ci_identifier_test.env (ignored by Git) and fill in values.
# Plain credentials may be used as SN_USERNAME / SN_PASSWORD instead.
SN_INSTANCE_URL=https://your-instance.service-now.com
SN_USERNAME_B64=
SN_PASSWORD_B64=
USBEM_SOURCE=genericJsonV2

# The identifier must select USBEM_EXPECTED_CI_SYS_ID. The decoy must be the name of a different,
# valid CI so this test fails if the connector incorrectly performs name lookup first.
USBEM_CI_TYPE=cmdb_ci_server
USBEM_CI_IDENTIFIER_JSON={"serial_number":"replace-with-unique-serial"}
USBEM_DECOY_CI_NAME=replace-with-a-different-existing-ci-name
USBEM_EXPECTED_CI_SYS_ID=replace-with-the-identifier-selected-ci-sys-id
USBEM_ASSIGNMENT_GROUP=
