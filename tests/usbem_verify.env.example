# Copy this file to usbem_verify.env. The filled-in file is ignored by Git.
# Use this one file for production URLs, OAuth credentials, and verifier fixtures.
# URLs are prefilled. Add OAuth credentials only for the instance(s) you will test.

# Production endpoint and OAuth settings. OAuth scope is optional.
USBEM_ITSMNOWDEVWORKER_URL=https://itsmnowDEVworker.service-now.com
USBEM_ITSMNOWDEVWORKER_OAUTH_CLIENT_ID=
USBEM_ITSMNOWDEVWORKER_OAUTH_CLIENT_SECRET=
USBEM_ITSMNOWDEVWORKER_OAUTH_SCOPE=

USBEM_ITSMNOWITWORKER_URL=https://itsmnowITworker.service-now.com
USBEM_ITSMNOWITWORKER_OAUTH_CLIENT_ID=
USBEM_ITSMNOWITWORKER_OAUTH_CLIENT_SECRET=
USBEM_ITSMNOWITWORKER_OAUTH_SCOPE=

USBEM_ITSMNOWUATWORKER_URL=https://itsmnowUATworker.service-now.com
USBEM_ITSMNOWUATWORKER_OAUTH_CLIENT_ID=
USBEM_ITSMNOWUATWORKER_OAUTH_CLIENT_SECRET=
USBEM_ITSMNOWUATWORKER_OAUTH_SCOPE=

USBEM_ITSMNOWWORKER_URL=https://itsmnowworker.service-now.com
USBEM_ITSMNOWWORKER_OAUTH_CLIENT_ID=
USBEM_ITSMNOWWORKER_OAUTH_CLIENT_SECRET=
USBEM_ITSMNOWWORKER_OAUTH_SCOPE=

# Common fixture values used against every selected instance. Leave unused checks blank.
USBEM_FIXTURE_CI_NAME=
USBEM_FIXTURE_CI_SYS_ID=
USBEM_FIXTURE_CI_TYPE=
# JSON object, for example: {"serial_number":"APPROVED_TEST_VALUE"}
USBEM_FIXTURE_CI_IDENTIFIER=
USBEM_FIXTURE_ASSIGNMENT_GROUP=
USBEM_FIXTURE_CI_SUPPORT_GROUP=
USBEM_FIXTURE_SERVICE_NAME=
USBEM_FIXTURE_OFFERING_NAME=
USBEM_FIXTURE_BUSINESS_APP_CAR_ID=

# User names are composed as "first name + last name". The last name is shared; the first name
# and user sys_ids below can vary for each instance. A sys_id is recommended for reliable checks.
USBEM_FIXTURE_CALLER_LAST_NAME=
USBEM_FIXTURE_ASSIGNED_TO_LAST_NAME=
# Optional exact full name with duplicate sys_user matches, for caller fallback testing.
USBEM_FIXTURE_AMBIGUOUS_CALLER_FULL_NAME=

# Per-instance user values. Set caller sys_id and first name for caller mapping checks. The default
# caller sys_id must match x_usbna_usb_event.default_caller_sys_id in that instance. Assignee values
# are optional; if omitted, the instance's on-call schedule can populate assigned_to.
USBEM_ITSMNOWDEVWORKER_FIXTURE_CALLER_SYS_ID=
USBEM_ITSMNOWDEVWORKER_FIXTURE_CALLER_FIRST_NAME=
USBEM_ITSMNOWDEVWORKER_FIXTURE_DEFAULT_CALLER_SYS_ID=
USBEM_ITSMNOWDEVWORKER_FIXTURE_ASSIGNED_TO_SYS_ID=
USBEM_ITSMNOWDEVWORKER_FIXTURE_ASSIGNED_TO_FIRST_NAME=

USBEM_ITSMNOWITWORKER_FIXTURE_CALLER_SYS_ID=
USBEM_ITSMNOWITWORKER_FIXTURE_CALLER_FIRST_NAME=
USBEM_ITSMNOWITWORKER_FIXTURE_DEFAULT_CALLER_SYS_ID=
USBEM_ITSMNOWITWORKER_FIXTURE_ASSIGNED_TO_SYS_ID=
USBEM_ITSMNOWITWORKER_FIXTURE_ASSIGNED_TO_FIRST_NAME=

USBEM_ITSMNOWUATWORKER_FIXTURE_CALLER_SYS_ID=
USBEM_ITSMNOWUATWORKER_FIXTURE_CALLER_FIRST_NAME=
USBEM_ITSMNOWUATWORKER_FIXTURE_DEFAULT_CALLER_SYS_ID=
USBEM_ITSMNOWUATWORKER_FIXTURE_ASSIGNED_TO_SYS_ID=
USBEM_ITSMNOWUATWORKER_FIXTURE_ASSIGNED_TO_FIRST_NAME=

USBEM_ITSMNOWWORKER_FIXTURE_CALLER_SYS_ID=
USBEM_ITSMNOWWORKER_FIXTURE_CALLER_FIRST_NAME=
USBEM_ITSMNOWWORKER_FIXTURE_DEFAULT_CALLER_SYS_ID=
USBEM_ITSMNOWWORKER_FIXTURE_ASSIGNED_TO_SYS_ID=
USBEM_ITSMNOWWORKER_FIXTURE_ASSIGNED_TO_FIRST_NAME=
