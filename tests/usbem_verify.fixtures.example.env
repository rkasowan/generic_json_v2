# Copy to usbem_verify.fixtures.env and fill in the stable, approved fixture values for this instance.
# The default file is ignored by Git so local instance values stay out of commits.
# For multiple instances, keep separate files and pass one with --fixture-file.
# Leave any unused value blank. Values are test references, not credentials.

# A CI may be specified by exact name or sys_id. At least one is needed for CI lookup checks.
USBEM_FIXTURE_CI_NAME=
USBEM_FIXTURE_CI_SYS_ID=

# Optional alternate CI lookup: class/table name plus a JSON object of identifier fields.
# Example format: {"serial_number":"YOUR_APPROVED_TEST_SERIAL"}
USBEM_FIXTURE_CI_TYPE=
USBEM_FIXTURE_CI_IDENTIFIER=

# Exact group name or sys_id; optional expected CI support group for fallback verification.
USBEM_FIXTURE_ASSIGNMENT_GROUP=
USBEM_FIXTURE_CI_SUPPORT_GROUP=

# Exact service and service offering names.
USBEM_FIXTURE_SERVICE_NAME=
USBEM_FIXTURE_OFFERING_NAME=

# Optional business application CAR ID.
USBEM_FIXTURE_BUSINESS_APP_CAR_ID=

# User references accept a sys_id or the exact full display name (first and last name).
# The first name may differ in each instance; update that part of each full name when anonymized.
# Either or both forms can be configured for caller_id and assigned_to.
# The validator checks these references through Incident readback and never queries sys_user.
# Set the sys_id alongside a full name when possible so validation compares the stored reference
# directly without relying on API display values.
USBEM_FIXTURE_CALLER_SYS_ID=
USBEM_FIXTURE_CALLER_FULL_NAME=
USBEM_FIXTURE_ASSIGNED_TO_SYS_ID=
USBEM_FIXTURE_ASSIGNED_TO_FULL_NAME=

# Match x_usbna_usb_event.default_caller_sys_id in this instance.
USBEM_FIXTURE_DEFAULT_CALLER_SYS_ID=

# Optional: exact sys_user.name that has multiple matches in this instance, to test caller fallback.
USBEM_FIXTURE_AMBIGUOUS_CALLER_FULL_NAME=
