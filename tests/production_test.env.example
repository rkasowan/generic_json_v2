# Generic JSON V2 production acceptance — one standalone Python 3.9+ tester.
# Copy this template to a PRIVATE .env file. Never commit filled credentials, fixtures,
# or detailed JSON reports. Base64 is reversible encoding, not a password hash.
# POSIX outputs use mode 0600. On Windows use a user-only NTFS folder: mode bits
# cannot establish private Windows ACLs for your credentials, catalogs or reports.
#
# READ-ONLY PLAN (no credentials or network needed):
#   python3 test_ci_identifier_precedence.py --access-profile production --plan
# ONE TARGET:
#   python3 test_ci_identifier_precedence.py --access-profile production --env-file production_test.env --fixture production-fixtures.json --report-file production-report.json
# EXISTING OAUTH PROFILE:
#   python3 test_ci_identifier_precedence.py --access-profile production --env-file usbem_verify.env --profile itsmnowDEVworker --fixture dev-fixtures.json --report-file dev-report.json
# Run each selected target separately; review the report before advancing DEV → IT → UAT → PROD.
# An explicitly selected blank profile URL stops before network; it never falls back to a PDI.
#
# Required access: existing genericJsonV2 connector POST, em_event READ, em_alert READ/WRITE,
# and incident READ/WRITE. The connector POST is separate from Event-table CREATE permission.
# Production mode uses ONLY those three tables. No direct Event create/update/delete, reference
# table reads, Scripts - Background, fixture provisioning, schema/security/property changes,
# deletes, service, scheduler, monitoring email, or legacy wait keys.
# Lifecycle/guard cases PATCH only the run's freshly verified owned Incidents and Alerts.
# Records are retained. Normal platform BRs and notifications still run; native mail is NOT
# suppressed. Use approved test CIs, caller, group and an agreed test window.
#
# The report separates three-table functional observations from evidence outside these rights:
# it cannot certify full journal history/counts, debug attachment bytes, installed BR source,
# or an unreadable non-Incident Task. Reference-source facts must be independently supplied
# and explicitly attested by your data owner. No hidden admin fallback is used.
# Note sentinels use the exact owned Incident/Alert's formatted visible work_notes view,
# after a fresh raw ownership check. Blank/missing formatted views are INCOMPLETE even for
# negative assertions; visible presence/absence is not complete raw history/exact global counts.

SN_INSTANCE_URL=https://replace-with-selected-instance.service-now.com

# Choose Basic OR OAuth. Leave all values for the unused method empty.
SN_USERNAME_B64=
SN_PASSWORD_B64=
USBEM_OAUTH_CLIENT_ID=
USBEM_OAUTH_CLIENT_SECRET=
USBEM_OAUTH_SCOPE=
# Plain SN_USERNAME/SN_PASSWORD and b64 OAuth keys are also supported. Prefer private env
# variables or your approved secret manager; do not put credentials in command-line arguments.
# Existing profiles use USBEM_<PROFILE>_URL / OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET / OAUTH_SCOPE.
# Target fixture settings below may also use USBEM_<PROFILE>_<KEY_WITHOUT_USBEM_PREFIX>.
# For Basic authentication a shared SN_USERNAME[_B64] may be combined with each profile's
# USBEM_<PROFILE>_PASSWORD[_B64]. USBEM_<PROFILE>_USERNAME[_B64] can override the shared user.
# Keep unconfigured URLs blank; select only one configured profile per invocation.
USBEM_DEV_URL=
USBEM_DEV_PASSWORD_B64=
USBEM_IT_URL=
USBEM_IT_PASSWORD_B64=
USBEM_UAT_URL=
USBEM_UAT_PASSWORD_B64=
USBEM_PROD_URL=
USBEM_PROD_PASSWORD_B64=

USBEM_SOURCE=genericJsonV2
USBEM_EXPECTED_RELEASE=2026.10.29.3

# Two DIFFERENT existing CIs in THIS target. Identifier-only/name-only positive controls
# must pass before conflict tests proceed. Obtain exact IDs/identifier facts from your owner.
USBEM_CI_TYPE=cmdb_ci_server
USBEM_CI_IDENTIFIER_JSON={"serial_number":"replace-with-unique-target-serial"}
USBEM_EXPECTED_CI_SYS_ID=replace-with-identifier-selected-ci-sys-id
USBEM_DECOY_CI_NAME=replace-with-different-existing-ci-name
USBEM_DECOY_CI_SYS_ID=replace-with-decoy-ci-sys-id

# Set the desired test assignment group here; no source-code edit is needed.
USBEM_ASSIGNMENT_GROUP=replace-with-existing-test-group-sys-id-or-name
USBEM_EXPECTED_ASSIGNMENT_GROUP_SYS_ID=replace-with-same-group-sys-id
USBEM_TEST_CALLER_SYS_ID=replace-with-existing-approved-test-caller-sys-id
USBEM_TEST_CATEGORY=replace-with-valid-category-stored-value
USBEM_EXPECTED_CATEGORY=replace-with-same-category-stored-value
USBEM_TEST_SUBCATEGORY=replace-with-valid-subcategory-stored-value
USBEM_EXPECTED_SUBCATEGORY=replace-with-same-subcategory-stored-value
USBEM_TEST_IMPACT=2
USBEM_TEST_URGENCY=2

# Full functional coverage needs the target's existing-reference fixture catalog. Use --fixture
# with a private JSON file or put the same JSON object on ONE LINE in this variable.
# This tester does not create missing users, CIs, services, offerings, custom fields or properties
# in production. Missing prerequisites/field ACLs are reported INCOMPLETE, never silently PASS.
USBEM_TEST_FIXTURES_JSON=
# Catalog keys and advanced-case shapes are documented in the KB and ordinary template.
# Production expected_incident / expected_event values must be stored-value STRINGS,
# e.g. "0", "false", ""; do not replace them with JSON numbers, booleans or null.
# expected_additional_info retains native JSON types and uses type-strict recursive comparison.
# Malformed catalogs stop preflight before Event writes; malformed raw stored types cannot pass.
# In addition to those existing target-specific fixtures, production mode needs explicit JSON
# booleans under production_attestations for branches whose source facts it cannot read:
# {
#   "production_attestations": {
#     "canonical_ci_name": true,
#     "canonical_group_name": true,
#     "l2_support_group": true,
#     "service_inference": true,
#     "offering_parent_filter": true,
#     "default_dummy_policy": true,
#     "ambiguous_user_rejection": true,
#     "car_id": true,
#     "ci_support_group": true
#   }
# }
# Do not set these blindly: the data owner must verify the configured canonical-name variants,
# existing CAR/L2/support fields and references, CI/service association, offering parent and
# mismatched-parent negative control, actual default CI, and genuinely ambiguous assignee name.
# Attestations qualify provenance; stored outputs must STILL equal the independent expected IDs.
# Never copy a generated DEV fixture catalog or PDI sys_ids into a production target.
# default_dummy_policy needs THREE non-DTI controls (configured-default positive, invalid
# explicit-CI blank negative, and no-hint blank negative). Supply default_ci_sys_id explicitly;
# it must agree with the positive control. The tester NEVER changes the production property.
# existing custom Incident fields must be readable for supplied field/back-reference checks.
# duplicate_work_note_enabled must match the target property; the test does not change it.
# If resolving your test Incident requires a cause, terminal_extra_fields may contain ONLY a
# nonempty string u_cause. terminal_close_code must use the target's valid stored choice.

# Observation uses actual processed Events, stored Alert links and stored Incident fields,
# with bounded continuous stability checks. No POST retries; a timeout is an unknown outcome.
# Allow time: a full manifest takes many minutes, not a quick endpoint smoke check.
USBEM_TEST_TIMEOUT_SECONDS=240
USBEM_FAST_POST_MAX_SECONDS=10
USBEM_TEST_STABLE_SECONDS=30
USBEM_TEST_POLL_SECONDS=3
USBEM_TEST_REQUEST_TIMEOUT_SECONDS=90
# Parallel first events exercise the accepted no-claim-table race and may create duplicate
# test Incidents. A single non-racing run never proves concurrency safety.
# Native severity 5/OK can create an Alert but the connector suppresses its automatic DTI
# Incident. Clear/severity 0 or a closing fresh Event does not create a fresh Alert.

# TLS verification stays on. Supply a PEM corporate CA bundle for a managed work laptop.
USBEM_CA_BUNDLE=
